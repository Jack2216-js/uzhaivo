{
  "expo": {
    "name": "Uzhaivo",
    "slug": "uzhaivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "uzhaivo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jacksonsri.uzhaivo"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc220a28-c836-408e-8ec8-0818d86f86af"
      }
    }
  }
}
