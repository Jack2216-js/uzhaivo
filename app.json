{
  "expo": {
    "name": "Uzhaivo",
    "slug": "uzhaivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "uzhaivo",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jacksonsri.uzhaivo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-build-properties",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc220a28-c836-408e-8ec8-0818d86f86af"
      }
    }
  }
}
